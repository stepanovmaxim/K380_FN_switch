#include <windows.h>

101 ICON "icon.ico"

#define VER_MAJOR 1
#define VER_MINOR 1
#define VER_PATCH 0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_MAJOR,VER_MINOR,VER_PATCH,0
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "K380 FN Switch - Fn lock for Logitech K380"
            VALUE "FileVersion",     "1.1.0.0"
            VALUE "InternalName",    "K380_FN_switch"
            VALUE "OriginalFilename","K380_FN_switch.exe"
            VALUE "ProductName",     "K380 FN Switch"
            VALUE "ProductVersion",  "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
